{
  "name": "bahbah",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node scripts/test.mjs",
    "seed": "node scripts/seed.mjs",
    "db:init": "wrangler d1 execute bahbah --remote --file=worker/schema.sql",
    "db:seed": "npm run seed && wrangler d1 execute bahbah --remote --file=worker/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
